# Copy to .env and fill in. Never commit .env.
# Use a wallet that has only ever touched testnets.

# Deployer key. No 0x prefix needed either way; hardhat accepts both.
PRIVATE_KEY=

# RPC overrides. Defaults in hardhat.config.js point at the public endpoints.
ELYSIUM_TESTNET_RPC=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_RPC=https://rpc.elysium.kinetiq.xyz

# Who owns the protocol at deploy time. Leave blank to use the deployer, then
# run scripts/deploy-timelock.js to hand everything to the timelock.
ADMIN_ADDRESS=
TREASURY_ADDRESS=

# Timelock settings (scripts/deploy-timelock.js)
# 172800 = 48h for mainnet. 3600 is reasonable on a testnet.
TIMELOCK_DELAY=3600
PROPOSERS=
CANCELLERS=

# Real token addresses for pools 2-7, if you are not using the testnet mocks.
# POOL_TOKENS={"UNI":"0x...","HYPE":"0x...","WBTC":"0x...","LINK":"0x...","DAI":"0x...","USDC":"0x..."}
POOL_TOKENS=
